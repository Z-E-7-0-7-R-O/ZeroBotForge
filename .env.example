# Non-secret application configuration example.
# Do not place a real Telegram bot token in this file or in any VITE_* variable.
# VITE_* variables are exposed to the renderer bundle.

VITE_APP_NAME=ZeroBotForge
ZEROBOTFORGE_LOG_LEVEL=info
# Optional absolute directory for application data. Leave empty to use the OS default.
ZEROBOTFORGE_DATA_DIR=
