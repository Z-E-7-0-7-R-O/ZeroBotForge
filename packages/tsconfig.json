{
    "extends":  "../tsconfig.base.json",
    "compilerOptions":  {
                            "target":  "ES2022",
                            "lib":  [
                                        "ES2022",
                                        "DOM"
                                    ],
                            "module":  "ESNext",
                            "moduleResolution":  "Bundler",
                            "types":  [
                                          "node",
                                          "vitest/globals"
                                      ],
                            "noEmit":  true,
                            "verbatimModuleSyntax":  true
                        },
    "include":  [
                    "shared/src/**/*.ts",
                    "project-format/src/**/*.ts",
                    "flow-engine/src/**/*.ts",
                    "telegram-adapter/src/**/*.ts"
                ],
    "exclude":  [
                    "**/dist/**",
                    "**/node_modules/**"
                ]
}
