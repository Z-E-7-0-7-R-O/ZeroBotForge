{
  "name": "zerobotforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A desktop application for designing Telegram bot conversation flows and generating standalone bot projects.",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.8.0"
  },
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n UI,Electron \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:ui": "npm --workspace @zerobotforge/desktop run dev",
    "dev:electron": "wait-on http://127.0.0.1:5173 && npm run build:electron && npm --workspace @zerobotforge/desktop run start:electron",
    "typecheck:packages": "tsc --noEmit -p packages/tsconfig.json",
    "typecheck": "npm run typecheck:packages && npm run typecheck:ui && npm run typecheck:electron",
    "build": "npm run typecheck && npm run build:ui && npm run build:electron",
    "build:ui": "npm --workspace @zerobotforge/desktop run build",
    "build:electron": "npm --workspace @zerobotforge/desktop run build:electron",
    "package:desktop": "npm run build && electron-builder --config electron-builder.yml",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck:ui": "npm --workspace @zerobotforge/desktop run typecheck",
    "typecheck:electron": "npm --workspace @zerobotforge/desktop run typecheck:electron"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "concurrently": "^9.1.2",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.6.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  }
}