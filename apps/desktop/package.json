{
    "name":  "@zerobotforge/desktop",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "main":  "dist-electron/main.cjs",
    "description":  "ZeroBotForge desktop application and React renderer.",
    "scripts":  {
                    "dev":  "vite --host 127.0.0.1 --port 5173 --strictPort",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "build:electron":  "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist-electron --external:electron --out-extension:.js=.cjs",
                    "start:electron":  "electron .",
                    "preview":  "vite preview --host 127.0.0.1",
                    "typecheck":  "tsc -b",
                    "typecheck:electron":  "tsc -p tsconfig.electron.json"
                },
    "dependencies":  {
                         "lucide-react":  "0.468.0",
                         "react":  "18.3.1",
                         "react-dom":  "18.3.1",
                         "@zerobotforge/flow-engine":  "0.1.0",
                         "@zerobotforge/code-generator":  "0.1.0"
                     },
    "devDependencies":  {
                            "@zerobotforge/project-format":  "0.1.0",
                            "@types/react":  "18.3.12",
                            "@types/react-dom":  "18.3.1",
                            "@vitejs/plugin-react":  "4.3.4",
                            "electron":  "44.7.0",
                            "esbuild":  "^0.25.0",
                            "vite":  "6.0.5"
                        }
}
